# --- Banco (use DATABASE_URL ou o conjunto DB_* da Hostinger) ---
DATABASE_URL="mysql://root:root@127.0.0.1:3306/regnus_leiloes"
# DB_HOST="" DB_PORT="3306" DB_NAME="" DB_USER="" DB_PASSWORD=""

# --- Autenticação (gere com: openssl rand -base64 32) ---
NEXTAUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@regnus.local"

# --- Crawler ---
CRAWLER_USER_AGENT="RegnusBot/1.0 (+https://regnus.com.br/bot)"
# CRAWLER_MIN_INTERVAL_MS="1000"   # intervalo mínimo por domínio
# CAIXA_DETAIL="0"                 # 1 = busca a página de cada imóvel da Caixa (horas)
# MEGA_DETAIL="0"                  # 1 = busca a página de cada lote do Mega Leilões
# BIASI_DETAIL="1"                 # 0 = só os dados do card

# --- Worker embutido no processo web (hospedagem sem VPS); veja docs/deploy.md ---
# ENABLE_WORKER="1"
# WORKER_START_DELAY_MS="20000"

# --- Geocodificação (Nominatim/OSM, 1 req/s) ---
GEOCODE="0"

# --- API pública ---
API_RATE_LIMIT="60"

# --- Alertas por e-mail (SMTP da Hostinger; em dev use Mailpit: host 127.0.0.1, porta 1025) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Regnus Leilões <alertas@regnus.com.br>"

# --- Build ---
# NEXT_BUILD_CPUS="2"
