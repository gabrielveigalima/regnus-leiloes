{
  "name": "regnus-leiloes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "crawl": "tsx src/crawler/cli.ts",
    "worker": "tsx src/worker/main.ts",
    "worker:tick": "tsx src/worker/tick.ts",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "geocode": "tsx src/geocode-cli.ts",
    "prebuild": "node scratch/prepare-db.js",
    "start:next": "next start",
    "db:migrate": "prisma migrate deploy",
    "db:drift": "prisma migrate diff --from-url \"$DATABASE_URL\" --to-schema-datamodel prisma/schema.prisma --exit-code",
    "test:build": "tsx --test test/build.test.ts",
    "build:docker": "next build --webpack",
    "crawl:prod": "tsx --env-file=.env.prod src/crawler/cli.ts",
    "geocode:prod": "tsx --env-file=.env.prod src/geocode-cli.ts",
    "overnight": "tsx src/overnight.ts",
    "overnight:prod": "tsx --env-file=.env.prod src/overnight.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.5.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
